generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  artifacts     Artifact[]
  chats         Chat[]
  feedbacks     Feedback[]
  personas      Persona[]
  providers     Provider[]
  sessions      Session[]
  workspaces    Workspace[]
  memberships   Membership[]
  decisionsCreated Decision[] @relation("DecisionCreatedBy")
  decisionsOwned   Decision[] @relation("DecisionOwner")
  approvals     Approval[]
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  name      String?
  email     String?
  message   String
  type      String   @default("general")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Provider {
  id          String    @id @default(cuid())
  name        String
  provider    String
  apiUrl      String    @default("https://api.openai.com/v1")
  apiKey      String
  model       String    @default("gpt-3.5-turbo")
  temperature Float     @default(0.7)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  creatorId   String?
  personas    Persona[]
  artifacts   Artifact[]
  creator     User?     @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
}

model Persona {
  id          String          @id @default(cuid())
  name        String
  bio         String
  personality String?
  // Job this participant does in a task: contributor | researcher | critic |
  // planner | synthesizer. Stored as text and validated in code so the set can
  // grow without a migration.
  role        String          @default("contributor")
  // Allowlisted tool names this participant may call (e.g. web_search). Empty
  // means the participant reasons from its own knowledge only.
  tools       String[]        @default([])
  providerId  String?
  model       String?
  temperature Float?
  avatarUrl   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  creatorId   String?
  messages    Message[]
  creator     User?           @relation(fields: [creatorId], references: [id])
  provider    Provider?       @relation(fields: [providerId], references: [id])
  chats       PersonaOnChat[]

  @@index([creatorId])
  @@index([providerId])
}

model Chat {
  id            String          @id @default(cuid())
  title         String          @default("New Chat")
  topic         String?
  // "debate" is the original adversarial-roleplay experience. "task" asks the
  // participants to cooperate on an objective and produce a deliverable.
  mode          String          @default("debate")
  // Structured brief. topic stays as the short label shown in lists.
  objective       String?
  deliverableSpec String?
  audience        String?
  // Which scoring rubric the synthesis judge should use for this run.
  rubricPreset  String          @default("balanced")
  isAutoMode    Boolean         @default(false)
  // Public share links are opt-in. The chat id is the public handle; keys are never selected.
  isPublic      Boolean         @default(false)
  lastSpeakerId String?
  // Scheduler state for server-side turn execution. autoAdvanceAt is the next
  // time this chat is due for a turn; null means it is not scheduled. The worker
  // claims due chats by pushing this forward, so a chat can never be advanced
  // twice by overlapping ticks.
  autoAdvanceAt  DateTime?
  // null while running open-ended (auto mode); a countdown for a bounded run
  // started from the "Start Debate" button.
  turnsRemaining Int?
  turnCount      Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  creatorId     String?
  creator       User?           @relation(fields: [creatorId], references: [id])
  messages      Message[]
  participants  PersonaOnChat[]
  artifacts     Artifact[]
  decisions     Decision[]

  @@index([creatorId])
  @@index([isAutoMode, autoAdvanceAt])
}

/// A produced deliverable: the synthesised answer for a chat, stored separately
/// from the transcript so it can be versioned and re-read on its own.
model Artifact {
  id         String   @id @default(cuid())
  chatId     String
  kind       String   @default("synthesis")
  title      String
  content    String
  model      String?
  // Rubric results. Every candidate is kept so a run is auditable: which
  // candidates were produced, how each scored, and which one won.
  score      Float?
  breakdown  Json?
  selected   Boolean  @default(true)
  round      Int      @default(1)
  /// Which generation angle produced this candidate (decisive, risk-aware, ...).
  angle      String?
  providerId String?
  createdById String?
  createdAt  DateTime @default(now())
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  provider   Provider? @relation(fields: [providerId], references: [id])
  createdBy  User?     @relation(fields: [createdById], references: [id])

  @@index([chatId])
  @@index([chatId, kind, selected])
  @@index([providerId])
  @@index([createdById])
}

model PersonaOnChat {
  id        String   @id @default(cuid())
  personaId String
  chatId    String
  joinedAt  DateTime @default(now())
  /// Explicit turn order. Without this the participants array came back in
  /// whatever order Postgres chose for the join rows, so speaker rotation was
  /// non-deterministic and a debate could open with a different agent each run.
  /// joinedAt cannot serve: Postgres now() is transaction-time, so every
  /// participant added in one call shares a timestamp.
  sortOrder Int      @default(0)
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([personaId, chatId])
  @@index([chatId, sortOrder])
}

model Message {
  id          String   @id @default(cuid())
  content     String
  role        String
  personaId   String?
  personaName String?
  // Tool calls made while producing this turn. Kept so a deliverable can be
  // checked against the sources its agents actually consulted.
  evidence    Json?
  // Turn telemetry for the run inspector. Old messages legitimately have no
  // values; the UI renders those as "not recorded" rather than guessing.
  selectionReason String?
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int?
  chatId      String
  createdAt   DateTime @default(now())
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  persona     Persona? @relation(fields: [personaId], references: [id])

  @@index([chatId])
  @@index([personaId])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  requests  Int      @default(0)
  limit     Int      @default(100)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A private diligence workspace. Decisions, evidence, approvals, and reports
/// are scoped to a workspace; membership is the authorization boundary.
model Workspace {
  id          String       @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  creatorId   String
  creator     User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  memberships Membership[]
  decisions   Decision[]

  @@index([creatorId])
  @@index([updatedAt])
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  /// OWNER | ADMIN | REVIEWER | VIEWER
  role        String    @default("VIEWER")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// A decision under review. This is the product object; a review room is an
/// optional conversation attached to it, not the other way around.
model Decision {
  id          String     @id @default(cuid())
  workspaceId String
  title       String
  summary     String?
  /// DRAFT | IN_REVIEW | APPROVED | ARCHIVED
  status      String     @default("DRAFT")
  /// LOW | MEDIUM | HIGH | CRITICAL
  impact      String     @default("MEDIUM")
  createdById String
  ownerId     String?
  /// Optional link to the review room (chat) where this decision was tested.
  reviewRoomId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User       @relation("DecisionCreatedBy", fields: [createdById], references: [id])
  owner       User?      @relation("DecisionOwner", fields: [ownerId], references: [id])
  reviewRoom  Chat?      @relation(fields: [reviewRoomId], references: [id], onDelete: SetNull)
  evidence    Evidence[]
  approvals   Approval[]
  reports     Report[]

  @@index([workspaceId, updatedAt])
  @@index([createdById])
  @@index([ownerId])
  @@index([reviewRoomId])
}

/// A source-backed claim. The quote and source path are the minimum; a hash is
/// required before an evidence pack can be called verified in a real sprint.
model Evidence {
  id         String   @id @default(cuid())
  decisionId String
  /// CODE | COMMIT | DOC | TEST | CONFIG | OTHER
  kind       String   @default("CODE")
  source     String
  commit     String?
  quote      String
  sha256     String?
  /// VERIFIED | DISPUTED | UNSUPPORTED | INFERRED | OPEN
  status     String   @default("VERIFIED")
  /// HIGH | MEDIUM | LOW
  confidence String   @default("MEDIUM")
  createdAt  DateTime @default(now())
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId, createdAt])
}

model Approval {
  id         String    @id @default(cuid())
  decisionId String
  actorId    String
  /// REVIEWER | APPROVER | OWNER
  role       String    @default("REVIEWER")
  /// PENDING | APPROVED | REJECTED
  status     String    @default("PENDING")
  note       String?
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?
  decision   Decision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  actor      User      @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@index([actorId])
}

model Report {
  id          String    @id @default(cuid())
  decisionId  String
  version     Int       @default(1)
  /// DRAFT | PUBLISHED
  status      String    @default("DRAFT")
  content     String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  decision    Decision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId, version])
}
