generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  artifacts     Artifact[]
  chats         Chat[]
  feedbacks     Feedback[]
  personas      Persona[]
  providers     Provider[]
  sessions      Session[]
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  name      String?
  email     String?
  message   String
  type      String   @default("general")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Provider {
  id          String    @id @default(cuid())
  name        String
  provider    String
  apiUrl      String    @default("https://api.openai.com/v1")
  apiKey      String
  model       String    @default("gpt-3.5-turbo")
  temperature Float     @default(0.7)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  creatorId   String?
  personas    Persona[]
  artifacts   Artifact[]
  creator     User?     @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
}

model Persona {
  id          String          @id @default(cuid())
  name        String
  bio         String
  personality String?
  // Job this participant does in a task: contributor | researcher | critic |
  // planner | synthesizer. Stored as text and validated in code so the set can
  // grow without a migration.
  role        String          @default("contributor")
  // Allowlisted tool names this participant may call (e.g. web_search). Empty
  // means the participant reasons from its own knowledge only.
  tools       String[]        @default([])
  providerId  String?
  model       String?
  temperature Float?
  avatarUrl   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  creatorId   String?
  messages    Message[]
  creator     User?           @relation(fields: [creatorId], references: [id])
  provider    Provider?       @relation(fields: [providerId], references: [id])
  chats       PersonaOnChat[]

  @@index([creatorId])
  @@index([providerId])
}

model Chat {
  id            String          @id @default(cuid())
  title         String          @default("New Chat")
  topic         String?
  // "debate" is the original adversarial-roleplay experience. "task" asks the
  // participants to cooperate on an objective and produce a deliverable.
  mode          String          @default("debate")
  // Structured brief. topic stays as the short label shown in lists.
  objective       String?
  deliverableSpec String?
  audience        String?
  // Which scoring rubric the synthesis judge should use for this run.
  rubricPreset  String          @default("balanced")
  isAutoMode    Boolean         @default(false)
  // Public share links are opt-in. The chat id is the public handle; keys are never selected.
  isPublic      Boolean         @default(false)
  lastSpeakerId String?
  // Scheduler state for server-side turn execution. autoAdvanceAt is the next
  // time this chat is due for a turn; null means it is not scheduled. The worker
  // claims due chats by pushing this forward, so a chat can never be advanced
  // twice by overlapping ticks.
  autoAdvanceAt  DateTime?
  // null while running open-ended (auto mode); a countdown for a bounded run
  // started from the "Start Debate" button.
  turnsRemaining Int?
  turnCount      Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  creatorId     String?
  creator       User?           @relation(fields: [creatorId], references: [id])
  messages      Message[]
  participants  PersonaOnChat[]
  artifacts     Artifact[]

  @@index([creatorId])
  @@index([isAutoMode, autoAdvanceAt])
}

/// A produced deliverable: the synthesised answer for a chat, stored separately
/// from the transcript so it can be versioned and re-read on its own.
model Artifact {
  id         String   @id @default(cuid())
  chatId     String
  kind       String   @default("synthesis")
  title      String
  content    String
  model      String?
  // Rubric results. Every candidate is kept so a run is auditable: which
  // candidates were produced, how each scored, and which one won.
  score      Float?
  breakdown  Json?
  selected   Boolean  @default(true)
  round      Int      @default(1)
  /// Which generation angle produced this candidate (decisive, risk-aware, ...).
  angle      String?
  providerId String?
  createdById String?
  createdAt  DateTime @default(now())
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  provider   Provider? @relation(fields: [providerId], references: [id])
  createdBy  User?     @relation(fields: [createdById], references: [id])

  @@index([chatId])
  @@index([chatId, kind, selected])
  @@index([providerId])
  @@index([createdById])
}

model PersonaOnChat {
  id        String   @id @default(cuid())
  personaId String
  chatId    String
  joinedAt  DateTime @default(now())
  /// Explicit turn order. Without this the participants array came back in
  /// whatever order Postgres chose for the join rows, so speaker rotation was
  /// non-deterministic and a debate could open with a different agent each run.
  /// joinedAt cannot serve: Postgres now() is transaction-time, so every
  /// participant added in one call shares a timestamp.
  sortOrder Int      @default(0)
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([personaId, chatId])
  @@index([chatId, sortOrder])
}

model Message {
  id          String   @id @default(cuid())
  content     String
  role        String
  personaId   String?
  personaName String?
  // Tool calls made while producing this turn. Kept so a deliverable can be
  // checked against the sources its agents actually consulted.
  evidence    Json?
  // Turn telemetry for the run inspector. Old messages legitimately have no
  // values; the UI renders those as "not recorded" rather than guessing.
  selectionReason String?
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int?
  chatId      String
  createdAt   DateTime @default(now())
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  persona     Persona? @relation(fields: [personaId], references: [id])

  @@index([chatId])
  @@index([personaId])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  requests  Int      @default(0)
  limit     Int      @default(100)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
