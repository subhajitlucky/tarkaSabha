generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  artifacts     Artifact[]
  chats         Chat[]
  feedbacks     Feedback[]
  personas      Persona[]
  providers     Provider[]
  sessions      Session[]
  workspaces    Workspace[]
  memberships   Membership[]
  decisionsCreated Decision[] @relation("DecisionCreatedBy")
  decisionsOwned   Decision[] @relation("DecisionOwner")
  approvals     Approval[]
  reportShares  ReportShare[]
  invitesCreated  WorkspaceInvite[] @relation("InvitesCreated")
  invitesAccepted WorkspaceInvite[] @relation("InvitesAccepted")
  sources         WorkspaceSource[]
  decisionCandidates DecisionCandidate[]
  decisionPins    DecisionPin[]
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  name      String?
  email     String?
  message   String
  type      String   @default("general")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Provider {
  id          String    @id @default(cuid())
  name        String
  provider    String
  apiUrl      String    @default("https://api.openai.com/v1")
  apiKey      String
  model       String    @default("gpt-3.5-turbo")
  temperature Float     @default(0.7)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  creatorId   String?
  personas    Persona[]
  artifacts   Artifact[]
  creator     User?     @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
}

model Persona {
  id          String          @id @default(cuid())
  name        String
  bio         String
  personality String?
  // Job this participant does in a task: contributor | researcher | critic |
  // planner | synthesizer. Stored as text and validated in code so the set can
  // grow without a migration.
  role        String          @default("contributor")
  // Allowlisted tool names this participant may call (e.g. web_search). Empty
  // means the participant reasons from its own knowledge only.
  tools       String[]        @default([])
  providerId  String?
  model       String?
  temperature Float?
  avatarUrl   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  creatorId   String?
  messages    Message[]
  creator     User?           @relation(fields: [creatorId], references: [id])
  provider    Provider?       @relation(fields: [providerId], references: [id])
  chats       PersonaOnChat[]

  @@index([creatorId])
  @@index([providerId])
}

model Chat {
  id            String          @id @default(cuid())
  title         String          @default("New Chat")
  topic         String?
  // "debate" is the original adversarial-roleplay experience. "task" asks the
  // participants to cooperate on an objective and produce a deliverable.
  mode          String          @default("debate")
  // Structured brief. topic stays as the short label shown in lists.
  objective       String?
  deliverableSpec String?
  audience        String?
  // Which scoring rubric the synthesis judge should use for this run.
  rubricPreset  String          @default("balanced")
  isAutoMode    Boolean         @default(false)
  // Public share links are opt-in. The chat id is the public handle; keys are never selected.
  isPublic      Boolean         @default(false)
  lastSpeakerId String?
  // Scheduler state for server-side turn execution. autoAdvanceAt is the next
  // time this chat is due for a turn; null means it is not scheduled. The worker
  // claims due chats by pushing this forward, so a chat can never be advanced
  // twice by overlapping ticks.
  autoAdvanceAt  DateTime?
  // null while running open-ended (auto mode); a countdown for a bounded run
  // started from the "Start Debate" button.
  turnsRemaining Int?
  turnCount      Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  creatorId     String?
  creator       User?           @relation(fields: [creatorId], references: [id])
  messages      Message[]
  participants  PersonaOnChat[]
  artifacts     Artifact[]
  decisions     Decision[]

  @@index([creatorId])
  @@index([isAutoMode, autoAdvanceAt])
}

/// A produced deliverable: the synthesised answer for a chat, stored separately
/// from the transcript so it can be versioned and re-read on its own.
model Artifact {
  id         String   @id @default(cuid())
  chatId     String
  kind       String   @default("synthesis")
  title      String
  content    String
  model      String?
  // Rubric results. Every candidate is kept so a run is auditable: which
  // candidates were produced, how each scored, and which one won.
  score      Float?
  breakdown  Json?
  selected   Boolean  @default(true)
  round      Int      @default(1)
  /// Which generation angle produced this candidate (decisive, risk-aware, ...).
  angle      String?
  providerId String?
  createdById String?
  createdAt  DateTime @default(now())
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  provider   Provider? @relation(fields: [providerId], references: [id])
  createdBy  User?     @relation(fields: [createdById], references: [id])

  @@index([chatId])
  @@index([chatId, kind, selected])
  @@index([providerId])
  @@index([createdById])
}

model PersonaOnChat {
  id        String   @id @default(cuid())
  personaId String
  chatId    String
  joinedAt  DateTime @default(now())
  /// Explicit turn order. Without this the participants array came back in
  /// whatever order Postgres chose for the join rows, so speaker rotation was
  /// non-deterministic and a debate could open with a different agent each run.
  /// joinedAt cannot serve: Postgres now() is transaction-time, so every
  /// participant added in one call shares a timestamp.
  sortOrder Int      @default(0)
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([personaId, chatId])
  @@index([chatId, sortOrder])
}

model Message {
  id          String   @id @default(cuid())
  content     String
  role        String
  personaId   String?
  personaName String?
  // Tool calls made while producing this turn. Kept so a deliverable can be
  // checked against the sources its agents actually consulted.
  evidence    Json?
  // Turn telemetry for the run inspector. Old messages legitimately have no
  // values; the UI renders those as "not recorded" rather than guessing.
  selectionReason String?
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int?
  chatId      String
  createdAt   DateTime @default(now())
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  persona     Persona? @relation(fields: [personaId], references: [id])

  @@index([chatId])
  @@index([personaId])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  requests  Int      @default(0)
  limit     Int      @default(100)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A private diligence workspace. Decisions, evidence, approvals, and reports
/// are scoped to a workspace; membership is the authorization boundary.
model Workspace {
  id          String       @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  creatorId   String
  creator     User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  memberships Membership[]
  decisions   Decision[]
  invites     WorkspaceInvite[]
  sources     WorkspaceSource[]
  candidates  DecisionCandidate[]

  @@index([creatorId])
  @@index([updatedAt])
}

/// A one-time, expiring invitation to join a workspace. Only the token hash is
/// stored; the raw link is shown to the inviter once.
model WorkspaceInvite {
  id           String    @id @default(cuid())
  workspaceId  String
  email        String
  /// REVIEWER | VIEWER | ADMIN | OWNER
  role         String    @default("REVIEWER")
  tokenHash    String    @unique
  createdById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User      @relation("InvitesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy   User?     @relation("InvitesAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@index([expiresAt])
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  /// OWNER | ADMIN | REVIEWER | VIEWER
  role        String    @default("VIEWER")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// A decision under review. This is the product object; a review room is an
/// optional conversation attached to it, not the other way around.
model Decision {
  id          String     @id @default(cuid())
  workspaceId String
  title       String
  summary     String?
  /// DRAFT | IN_REVIEW | APPROVED | ARCHIVED
  status      String     @default("DRAFT")
  /// LOW | MEDIUM | HIGH | CRITICAL
  impact      String     @default("MEDIUM")
  createdById String
  ownerId     String?
  /// Optional link to the review room (chat) where this decision was tested.
  reviewRoomId String?
  /// 0-100: higher means more unresolved decision debt.
  debtScore   Int        @default(0)
  debtRationale String?
  scoredAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User       @relation("DecisionCreatedBy", fields: [createdById], references: [id])
  owner       User?      @relation("DecisionOwner", fields: [ownerId], references: [id])
  reviewRoom  Chat?      @relation(fields: [reviewRoomId], references: [id], onDelete: SetNull)
  evidence    Evidence[]
  approvals   Approval[]
  reports     Report[]
  candidate   DecisionCandidate?
  pins        DecisionPin[]

  @@index([workspaceId, updatedAt])
  @@index([createdById])
  @@index([ownerId])
  @@index([reviewRoomId])
}

/// A testable decision point. The separating test distinguishes the chosen
/// behavior from the alternative so the decision can be checked, not just read.
model DecisionPin {
  id                  String    @id @default(cuid())
  decisionId          String
  ownerId             String?
  decisionPoint       String
  chosenValue         String
  separatingTest      String
  expectedResult      String?
  codeScope           String?
  /// ACTIVE | SUPERSEDED
  status              String    @default("ACTIVE")
  lastRunAt           DateTime?
  lastRunResult       String?
  supersessionTrigger String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  decision            Decision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  owner               User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([decisionId, status])
  @@index([ownerId])
}

/// A source-backed claim. The quote and source path are the minimum; a hash is
/// required before an evidence pack can be called verified in a real sprint.
model Evidence {
  id         String   @id @default(cuid())
  decisionId String
  /// CODE | COMMIT | DOC | TEST | CONFIG | OTHER
  kind       String   @default("CODE")
  source     String
  commit     String?
  quote      String
  sha256     String?
  /// VERIFIED | DISPUTED | UNSUPPORTED | INFERRED | OPEN
  status     String   @default("VERIFIED")
  /// HIGH | MEDIUM | LOW
  confidence String   @default("MEDIUM")
  createdAt  DateTime @default(now())
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId, createdAt])
}

model Approval {
  id         String    @id @default(cuid())
  decisionId String
  actorId    String
  /// REVIEWER | APPROVER | OWNER
  role       String    @default("REVIEWER")
  /// PENDING | APPROVED | REJECTED
  status     String    @default("PENDING")
  note       String?
  /// SHA-256 of the decision/evidence snapshot this approval covers.
  contentHash String?
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?
  decision   Decision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  actor      User      @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@index([actorId])
}

model Report {
  id          String    @id @default(cuid())
  decisionId  String
  version     Int       @default(1)
  /// DRAFT | PUBLISHED
  status      String    @default("DRAFT")
  content     String?
  /// SHA-256 of the generated report content.
  contentHash String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  decision    Decision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  shares      ReportShare[]

  @@unique([decisionId, version])
}

/// An expiring, revocable public link to a report snapshot. Only the SHA-256
/// hash of the bearer token is stored; the raw token is shown once at creation.
model ReportShare {
  id            String    @id @default(cuid())
  reportId      String
  createdById   String
  tokenHash     String    @unique
  expiresAt     DateTime
  /// Hide source paths, commits, and evidence hashes in the shared view.
  redactSources Boolean   @default(false)
  viewCount     Int       @default(0)
  lastViewedAt  DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  report        Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdBy     User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([expiresAt])
}

/// A repository ingestion run. Snapshots are immutable; a fresh run creates a
/// new source record so the evidence can be tied to a point in time.
model WorkspaceSource {
  id               String           @id @default(cuid())
  workspaceId      String
  createdById      String
  provider         String           @default("github")
  repoUrl          String
  owner            String
  name             String
  ref              String
  commitSha        String?
  status           String           @default("READY")
  error            String?
  fileCount        Int              @default(0)
  commitCount      Int              @default(0)
  pullRequestCount Int              @default(0)
  issueCount       Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  snapshots        SourceSnapshot[]
  candidates       DecisionCandidate[]

  @@index([workspaceId, updatedAt])
}

model SourceSnapshot {
  id          String         @id @default(cuid())
  sourceId    String
  /// FILE | COMMIT | PULL_REQUEST | ISSUE
  kind        String
  path        String
  title       String?
  content     String?
  url         String
  sha         String?
  sha256      String?
  size        Int?
  metadata    Json?
  retrievedAt DateTime       @default(now())
  createdAt   DateTime       @default(now())
  source      WorkspaceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  candidateEvidence CandidateEvidence[]

  @@index([sourceId, kind])
  @@index([sourceId, path])
}

/// An LLM-proposed decision. A human must confirm it before it becomes a real
/// Decision; rejection is terminal and kept for the audit trail.
model DecisionCandidate {
  id          String    @id @default(cuid())
  workspaceId String
  sourceId    String
  createdById String
  title       String
  context     String?
  proposal    String?
  rationale   String?
  /// HIGH | MEDIUM | LOW
  confidence  String    @default("MEDIUM")
  /// PENDING | CONFIRMED | REJECTED
  status      String    @default("PENDING")
  decisionId  String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source      WorkspaceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  decision    Decision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  evidence    CandidateEvidence[]

  @@index([workspaceId, status])
  @@index([sourceId, status])
}

model CandidateEvidence {
  id          String            @id @default(cuid())
  candidateId String
  snapshotId  String
  quote       String?
  createdAt   DateTime          @default(now())
  candidate   DecisionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  snapshot    SourceSnapshot    @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([candidateId, snapshotId])
  @@index([snapshotId])
}
